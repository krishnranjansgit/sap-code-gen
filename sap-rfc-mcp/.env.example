# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.

# --- Direct Application Server connection ---
SAP_ASHOST=your-app-server-hostname
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=your-username
SAP_PASSWD=your-password
SAP_LANG=EN

# --- OR use Message Server / logon group routing instead of ASHOST ---
# SAP_MSHOST=your-message-server
# SAP_MSSERV=3600
# SAP_R3NAME=SID
# SAP_GROUP=PUBLIC

# --- Optional: only needed if you connect through a SAProuter ---
# SAP_SAPROUTER=/H/router-host/S/3299
