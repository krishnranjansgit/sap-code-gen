# Copy to .env and fill in (or just run `python3 setup.py`, which writes
# this file for you). Never commit the real .env.

# MCP server names -- must match whatever you used in `claude mcp add
# <name> ...` for Jira/Wiki and SAP RFC.
JIRA_WIKI_MCP_NAME=mcp-atlassian
SAP_RFC_MCP_NAME=sap-rfc

# Confluence workaround scripts (confluence_search.py / confluence_get_page.py)
# -- same values as registered on the mcp-atlassian MCP server.
CONFLUENCE_URL=https://wiki.example.com
CONFLUENCE_PERSONAL_TOKEN=

# Local clone of https://github.com/aws-solutions-library-samples/
# guidance-for-deploying-sap-abap-accelerator-for-amazon-q-developer
ABAP_ACCELERATOR_DIR=/path/to/abap-accelerator-mcp

# Local clone of your abapGit target repo (generated code lands here,
# pulled into SAP via zabapgit)
ABAPGIT_REPO_DIR=/path/to/your-abapgit-repo

# Your Claude Code subscription token (see README) -- typically exported
# in your shell profile instead of here, but either works.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
